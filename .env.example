# Copy this file to .env and fill in your values. See README.md for how to
# get a device_id and registration_token.

# Base URL of the Project Aziz backend (no trailing slash).
EYES_OF_AZIZ_BACKEND_URL=https://projectaziz.com

# Issued by POST /api/field-devices/register (device_type=camera_bridge).
EYES_OF_AZIZ_DEVICE_ID=
EYES_OF_AZIZ_REGISTRATION_TOKEN=

# RTSP URL for the camera this bridge reads from, e.g.
# rtsp://username:password@192.168.1.50:554/stream1
EYES_OF_AZIZ_RTSP_URL=

# --- Optional tuning (defaults shown) ---

# How often to capture and upload a frame. Bounds API/Rekognition cost on
# the backend -- lower this only if you need faster detection.
# EYES_OF_AZIZ_CAPTURE_INTERVAL_SECONDS=10

# JPEG quality (1-100) for uploaded frames.
# EYES_OF_AZIZ_JPEG_QUALITY=85

# HTTP timeout per upload attempt, in seconds.
# EYES_OF_AZIZ_REQUEST_TIMEOUT_SECONDS=15

# How many times to retry a single frame upload before giving up on it.
# EYES_OF_AZIZ_MAX_SEND_RETRIES=3

# Backoff (seconds) before the first RTSP reconnect attempt after the
# stream drops; doubles on each consecutive failure up to the max below.
# EYES_OF_AZIZ_RECONNECT_BACKOFF_SECONDS=5
# EYES_OF_AZIZ_MAX_RECONNECT_BACKOFF_SECONDS=60

# EYES_OF_AZIZ_LOG_LEVEL=INFO
